# CourseCompass Frontend Environment Configuration

# Base URL for FastAPI Backend API Gateway
# During local development with proxy: /api/v1
# Direct backend address: http://localhost:8000/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Demo Mode fallback toggle
# When set to false, all operations execute strictly against the live FastAPI server.
# When the server is offline or in demo mode, mock fallbacks provide resilient offline exploration.
VITE_DEMO_MODE="false"
